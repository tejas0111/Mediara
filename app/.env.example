[TEMPLATE]
# Mediara env — copy to .env and fill in. Placeholders only, no real secrets.
# cp .env.example .env

# local (default, keyless demo) or mainnet (real Walrus Memory — only with owner keys)
MEMWAL_MODE=local

# Owner Walrus Memory account id (mainnet only; placeholder — never commit real value)
MEMWAL_ACCOUNT_ID=your-memwal-account-id-here

# Owner Walrus Memory private key (mainnet only; placeholder — never commit real value)
MEMWAL_PRIVATE_KEY=your-memwal-private-key-here

# Hosted relayer URL (pays WAL/SUI for you; match it to where the account was created)
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# OpenRouter key for LLM replies (optional; without it the bot echoes + still exercises memory)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# LLM model (Beyond Big Two eligible default)
LLM_MODEL=google/gemini-2.5-flash

# Telegram bot token from @BotFather (only needed for node src/telegram.js)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Session signing secret for wallet sign-in cookies (any long random string;
# set a fixed value in production so sessions survive restarts)
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: dedicated gas sponsor wallet for user onboarding (defaults to the
# owner key above). NOT needed for the standard user-pays onboarding flow.
# SPONSOR_PRIVATE_KEY=your-sponsor-private-key-here

# Sui GraphQL endpoint (default below; override only if needed)
# SUI_GRAPHQL_URL=https://graphql.mainnet.sui.io/graphql

# Web server port
PORT=3001
